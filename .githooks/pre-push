#!/usr/bin/env bash
# The push gate: the whole suite — unit, dom and the database tests, then the
# browser measurements (Playwright on the installed Chrome) when the board is
# touched — since
# every push goes to main or to a pull request. The commit hook ran only the
# tests related to each commit; this is where everything is proven together.
#
# The database tests need the local stack (pnpm db:start); a stack that is
# down fails the push rather than skipping. Bypassing it with --no-verify is
# not how work lands.
set -euo pipefail

# What is pushed, read before anything else can take stdin.
refs="$(cat)"

printf '\n→ push gate: the whole suite\n'
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
pnpm -s test > "$out" 2>&1 || {
  grep -E '×|FAIL|Tests |Error' "$out" | head -20 >&2
  echo '✖ tests failed: nothing pushed' >&2
  exit 1
}
grep -E 'Tests ' "$out" || true

# Direct manipulation measured in Chrome (e2e/, the /dev/board fixture): it
# reuses a dev server that is already up, else starts one. Only when the push
# touches the board or what the measurements run on (review: minutes a push,
# for nothing, otherwise); E2E=1 runs them anyway. A range git cannot name
# (a new branch, a remote commit not here) runs them too.
board_paths='^(features/month-board/|app/dev/|e2e/|patches/|playwright\.config\.ts$|package\.json$|pnpm-lock\.yaml$|next\.config\.ts$|app/globals\.css$)'
zero='0000000000000000000000000000000000000000'
touched=''
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a deletion pushes no code
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    touched='unknown'
    break
  fi
  if git diff --name-only "$remote_sha" "$local_sha" | grep -Eq "$board_paths"; then
    touched='yes'
    break
  fi
done <<< "$refs"
if [ "${E2E:-}" != '1' ] && [ -z "$touched" ]; then
  printf '\n→ push gate: the browser measurements skipped (no board change; E2E=1 runs them)\n'
  printf '\n✓ push gate passed\n'
  exit 0
fi
printf '\n→ push gate: the browser measurements\n'
pnpm -s test:e2e > "$out" 2>&1 || {
  grep -E '✘|failed|Error|expect' "$out" | head -20 >&2
  echo '✖ browser measurements failed: nothing pushed' >&2
  exit 1
}
grep -E 'passed' "$out" | tail -1 || true
printf '\n✓ push gate passed\n'
