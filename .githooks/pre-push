#!/usr/bin/env bash
# The push gate: the whole suite — unit, dom and the database tests, then the
# browser measurements (Playwright on the installed Chrome) — since
# every push goes to main or to a pull request. The commit hook ran only the
# tests related to each commit; this is where everything is proven together.
#
# The database tests need the local stack (pnpm db:start); a stack that is
# down fails the push rather than skipping. Bypassing it with --no-verify is
# not how work lands.
set -euo pipefail

printf '\n→ push gate: the whole suite\n'
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
pnpm -s test > "$out" 2>&1 || {
  grep -E '×|FAIL|Tests |Error' "$out" | head -20 >&2
  echo '✖ tests failed: nothing pushed' >&2
  exit 1
}
grep -E 'Tests ' "$out" || true

# Direct manipulation measured in Chrome (e2e/, the /dev/board fixture): it
# reuses a dev server that is already up, else starts one.
printf '\n→ push gate: the browser measurements\n'
pnpm -s test:e2e > "$out" 2>&1 || {
  grep -E '✘|failed|Error|expect' "$out" | head -20 >&2
  echo '✖ browser measurements failed: nothing pushed' >&2
  exit 1
}
grep -E 'passed' "$out" | tail -1 || true
printf '\n✓ push gate passed\n'
