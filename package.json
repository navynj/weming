{
  "name": "weming",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && ./scripts/check-tokens.sh && ./scripts/check-origin.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:start": "set -a; [ -f .env.local ] && . ./.env.local; set +a; supabase start",
    "db:reset": "./scripts/guard-destructive.sh \"db reset\" \"$@\" && supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "check:tokens": "./scripts/check-tokens.sh",
    "predev": "./scripts/check-stack.sh",
    "seed:me": "./scripts/assert-local.sh && ./scripts/seed-me.sh",
    "test:ci": "vitest run --project unit --project unit-iso --project dom",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm test:ci",
    "backup": "./scripts/backup.sh",
    "db:push": "./scripts/db-push.sh",
    "verify:prod": "node scripts/verify-prod-rls.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@sentry/nextjs": "11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "heic2any": "0.0.4",
    "lucide-react": "^1.47.0",
    "motion": "^14.6.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.33.2"
}
